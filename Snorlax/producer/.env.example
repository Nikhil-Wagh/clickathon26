# ClickHouse Cloud connection — copy to .env and fill in.
# Find these in the Cloud console: Connect → "HTTPS" / native.
CLICKHOUSE_HOST=your-instance.region.clickhouse.cloud
CLICKHOUSE_PORT=443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_SECURE=true

# Where the dummy events land.
CLICKHOUSE_DATABASE=sonyliv_concurrency
CLICKHOUSE_TABLE=events_incoming

# Producer tuning.
EVENTS_PER_SECOND=200      # target insert rate
BATCH_SIZE=1000            # rows per INSERT (server-side async batching still applies)
FLUSH_INTERVAL_SEC=1.0     # max seconds to hold a partial batch before flushing
MAX_CONCURRENT_SESSIONS=500
